{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "api/*": ["./app/api/*"],
      "custom/*": ["./components/custom/*"],
      "data": ["./app/data.ts"],
      "motion-primitives/*": ["./components/motion-primitives/*"],
      "shad-ui/*": ["./components/shad-ui/*"],
      "types": ["./types"],
      "types/*": ["./types/*"],
      "utils": ["./lib/utils.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.mjs"
  ],
  "exclude": ["node_modules", "archive"]
}
